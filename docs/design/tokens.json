  "motion": {
    "fast": 150,
    "base": 250,
    "slow": 350,
    "easeIn": "cubic-bezier(0.4, 0, 1, 1)",
    "easeOut": "cubic-bezier(0, 0, 0.2, 1)"
  },
  "rules": {
    "emberPerScreen": 1,
    "minTextSize": 12,
    "maxTextScale": 1.3,
    "reconnectHoldSeconds": 30,
    "roomMinPeople": 3,
    "roomDropWaitSeconds": 120,
    "matchFallbackSeconds": 15,
    "circleLobbyOpensMinutesBefore": 5,
    "nicknameChangeDays": 30
  }
