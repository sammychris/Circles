    "heading":    { "size": 18, "lineHeight": 24, "weight": 800 },
    "body":       { "size": 16, "lineHeight": 24, "weight": 400 },
    "bodyStrong": { "size": 16, "lineHeight": 22, "weight": 700 },
    "meta":       { "size": 14, "lineHeight": 20, "weight": 400 },
    "metaStrong": { "size": 14, "lineHeight": 20, "weight": 700 },
    "tiny":       { "size": 12, "lineHeight": 16, "weight": 700 },
    "button":     { "size": 18, "lineHeight": 24, "weight": 800 }
