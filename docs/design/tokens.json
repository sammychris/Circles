  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "gutter": 24 },
  "radius": { "small": 12, "card": 20, "sheet": 28, "pill": 999 },
  "shadow": {
    "raised": "inset 0 1px 0 rgba(255,236,214,0.06)",
    "sheet": "inset 0 1px 0 rgba(255,236,214,0.08), 0 -16px 48px rgba(0,0,0,0.45)",
    "glow": "inset 0 1px 0 rgba(255,255,255,0.35), 0 8px 24px rgba(244,161,78,0.22)",
    "speaking": "0 0 0 4px {bg}, 0 0 0 7px {live}, 0 0 24px 8px rgba(84,201,154,0.25)",
    "roomGlow": "radial-gradient(circle, rgba(244,161,78,0.20) 0%, rgba(244,161,78,0.06) 45%, rgba(244,161,78,0) 70%)"
  },
  "border": { "input": 2, "selected": 2, "seatRing": 2 },
  "size": {
    "minTarget": 44,
    "buttonPrimary": 56,
    "buttonSecondary": 44,
    "micControl": 64,
    "iconButton": 44,
    "bottomNav": 76,
    "avatarRoom": 64,
    "avatarList": 44,
    "avatarProfile": 64,
    "avatarBadge": 24,
    "roomRingLarge": 264,
    "avatarSeatSmall": 48,
    "maxSeats": 10,
    "moodTileHome": 88,
    "moodTileCompact": 64,
    "roomRing": 248,
    "input": 56,
    "icon": 24,
    "iconButtonGlyph": 20,
    "iconMeta": 16,
    "iconStroke": 2
